#!/usr/bin/python3
"""ms — my-system command line.

  ms                     status summary
  ms gui                 open the desktop app
  ms check               full health check now (same as the daily job)
  ms watch               one watcher tick (run every minute by a timer)
  ms detect [--state]    show what was detected (--state: refresh state/detected.json)
  ms ai-context          regenerate the AI system map (state/SYSTEM_MAP.md, state/AGENTS.md)
  ms results DIR         extract results from finished runs below DIR into reports/results.csv
  ms git                 git status of all detected projects
  ms sizes               measure tracked folder sizes
  ms forecast            root-disk forecast
  ms digest              weekly summary now
  ms notify-test         send a test notification
  ms accept              accept the current content of watched files
  ms lock | unlock       protect / edit config, rules and code (needs sudo)
  ms backup-setup | backup | backup-verify
  ms move FOLDER         move a folder to the data disk and leave a link
  ms report [--open]     full system report (HTML + Markdown) in reports/system/
  ms q ...               job queue: starts jobs only when CPU and RAM are free (ms q help)
  ms flow ...            steps, sweeps and dependencies from a YAML file (ms flow help)
  ms mcp                 MCP server for AI assistants (stdio)
  ms sem NAME[:N] -- CMD run CMD holding a named semaphore slot
  ms lineage FILE        which job produced / used this exact file
  ms secret list|set|rm  secrets for jobs (masked in logs)
  ms software ...        updates, who uses which program/library (ms software help)
  ms selftest [--quick]  safe end-to-end test of my-system on this machine
  ms log ...             standard run logs (msrun.jsonl): run, check, show, list, index, template
  ms capacity [TOOL]     how many more jobs fit right now (for you and AI assistants)
  ms hw                  hardware health (disks, memory modules, fans, firmware)
  ms doctor              self-check of my-system itself
  ms replay TIME         what the machine was doing then (load, RAM, biggest programs, jobs); ms replay crashes
  ms ping NAME [start|fail|CODE]   dead-man's-switch ping to PING_<NAME> in my_system.conf
  ms housekeeping        rotate / trim my-system's own logs (daily job does this)
  ms brief [--send]      status report: system, running, waiting, last 3 finished (--send: to the phone now)
"""
import os
import subprocess
import sys
import time
from pathlib import Path

MS = Path(os.environ.get("MY_SYSTEM", Path.home() / "My_System"))
sys.path.insert(0, str(MS / "lib"))
sys.path.insert(0, str(MS / "plugins"))
sys.path.insert(0, str(MS / "runlog"))

from mysys import __version__, aictx, capacity, config, runlog, detect, digest, gitstat, hw, plugins, probes, sysreport, watcher  # noqa: E402

BIN = MS / "bin"


def sh(script, *args):
    return subprocess.call([str(BIN / script), *args])


def status():
    d = probes.disk("/")
    c = config.load()
    print(f"my-system {__version__} · {c['MACHINE_LABEL']} · {probes.os_name()}")
    if d:
        print(f"  root disk  {d[0] / d[2] * 100:.0f}% used, {d[1] / 2**30:.0f} GB free — {watcher.forecast_text()}")
    for dd in config.words("DATA_DISKS"):
        x = probes.disk(dd)
        print(f"  {dd:10} " + (f"{x[1] / 2**40:.1f} TB free" if x else "NOT MOUNTED"))
    m = probes.meminfo()
    print(f"  memory     {m.get('MemAvailable', 0) / 2**30:.0f} GB available of {m.get('MemTotal', 0) / 2**30:.0f} GB")
    t = probes.cpu_temp()
    l1 = probes.loadavg()[0]
    print(f"  cpu        load {l1:.1f} / {probes.threads()} threads" + (f", {t} °C" if t is not None else ""))
    j = watcher.jobs()
    print(f"  jobs       {len(j)} running" + (": " + ", ".join(sorted({x['tool'] for x in j})) if j else ""))
    print(f"  backup     {config.backup_state()[1]}")
    s = (config.REPORTS / "latest" / "summary.txt")
    if s.exists():
        w = [l for l in s.read_text().splitlines() if l.startswith("WARN")]
        print(f"  last check {len(w)} warning(s)" + "".join(f"\n    - {x[6:]}" for x in w))
    if probes.reboot_required():
        print("  reboot     required")


def results_backfill(root, write):
    root = Path(root).resolve()
    names = set()
    for p in plugins.load():
        for v in getattr(p, "LOGS", {}).values():
            names.update(v)
    n = 0
    for dirpath, dirnames, files in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".") and d not in (".Xil",)]
        hit = names.intersection(files)
        if not hit:
            continue
        for p in plugins.load():
            for tool, logs in getattr(p, "LOGS", {}).items():
                if set(logs) & hit and hasattr(p, "results"):
                    try:
                        res = p.results(dirpath, tool)
                    except Exception:
                        res = None
                    summ = p.log_summary(dirpath, tool) if hasattr(p, "log_summary") else None
                    if res is None and summ is None:
                        continue
                    n += 1
                    errs = (summ or {}).get("errors") or 0
                    print(f"{tool:9} {('FAILED' if errs else 'ok'):6} {dirpath}  {res or ''}")
                    if write:
                        r = {"tool": tool, "cwd": dirpath, "start": 0, "plugin": p.NAME}
                        watcher.record_result(r, 0, summ, "failed" if errs else "ok")
                    break
    print(f"{n} run folder(s) found" + (" and added to reports/results.csv" if write and n else ""))


LOG_HELP = """ms log — standard run logs (format: ~/My_System/runlog/RUNLOG_SPEC.md)

  ms log run [--name N] [--folder DIR] -- CMD ...   run CMD and record it (output kept in msrun.out)
  ms log start NAME [key=value ...]                 shell scripts: begin a run in the current folder
  ms log stage NAME | msg LEVEL TEXT | metric NAME VALUE [UNIT] | artifact PATH KIND | progress PCT [TEXT]
  ms log end ok|failed|cancelled [RC] [ERROR TEXT]
  ms log check PATH        validate files against the spec (exit 1 on any problem)
  ms log show PATH [N]     readable timeline of the last N runs in PATH (file or folder)
  ms log list [N]          all known runs, newest first
  ms log index             search project folders for run logs
  ms log template python|tcl|spec   print a writer to copy into a project
  ms log compare [PATH ...] [--sort METRIC] [--desc] [--all-columns] [--status ok] [--name RE] [--csv FILE]
                           params and metrics of many runs side by side (only columns that differ)
  ms log diff RUN_A RUN_B  what differs between two runs (params, metrics, git commit, status)
"""


def _log_state_path(folder=None):
    return Path(folder or os.getcwd()) / ".msrun_current"


def _shell_run(state=None, folder=None):
    import msrun
    import json as _json
    sp = _log_state_path(folder)
    st = state or _json.loads(sp.read_text())
    r = msrun.Run(st["name"], folder=st["folder"])
    r.run, r._t0, r._stage = st["run"], st["t0"], st.get("stage")
    r._f = open(r.path, "a", buffering=1, encoding="utf-8")
    return r, st


def _save_shell(r, st):
    import json as _json
    st["stage"] = r._stage
    _log_state_path(st["folder"]).write_text(_json.dumps(st))


def log_cmd(rest):
    import json as _json
    import msrun
    if not rest or rest[0] in ("-h", "--help", "help"):
        print(LOG_HELP)
        return 0
    sub, a = rest[0], rest[1:]
    if sub == "compare":
        def opt(k):
            return a[a.index(k) + 1] if k in a and a.index(k) + 1 < len(a) else None
        flags = {"--sort", "--status", "--name", "--csv"}
        paths = [x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or a[i - 1] not in flags)]
        runs = runlog.collect(paths, opt("--status"), opt("--name"))
        if not runs:
            print("no runs found")
            return 1
        header, rows = runlog.compare_table(runs, opt("--sort"), "--desc" in a, "--all-columns" not in a)
        if opt("--csv"):
            import csv as _csv
            with open(opt("--csv"), "w", newline="") as f:
                w = _csv.writer(f)
                w.writerow(header)
                w.writerows(rows)
            print(f"written {opt('--csv')} ({len(rows)} runs)")
        else:
            runlog.print_table(header, rows)
        return 0
    if sub == "diff":
        if len(a) < 2:
            print("usage: ms log diff RUN_A RUN_B   (run id, id prefix or run name = its newest run)")
            return 2
        ra, rb = runlog.find_run(a[0]), runlog.find_run(a[1])
        if not ra or not rb:
            print(f"run not found: {a[0] if not ra else a[1]}")
            return 1
        print(f"A = {ra['name']} {ra['run'][:12]}  ({ra['folder']})\nB = {rb['name']} {rb['run'][:12]}  ({rb['folder']})")
        d = runlog.diff(ra, rb)
        if not d:
            print("no differences in params, metrics or status")
        for kind, k, va, vb in d:
            print(f"  {kind:<7} {k:<30} {runlog._cell(va) if va is not None else '–':>14}  →  {runlog._cell(vb) if vb is not None else '–'}")
        return 0
    if sub == "template":
        f = {"python": "msrun.py", "tcl": "msrun.tcl", "spec": "RUNLOG_SPEC.md"}.get(a[0] if a else "", None)
        if not f:
            print("usage: ms log template python|tcl|spec")
            return 2
        sys.stdout.write((MS / "runlog" / f).read_text())
        return 0
    if sub == "check":
        target = Path(a[0] if a else ".")
        files = [target] if target.is_file() else sorted(target.rglob(runlog.FILENAME))
        if not files:
            print(f"no {runlog.FILENAME} found in {target}")
            return 1
        bad = 0
        for f in files:
            probs = runlog.validate(f)
            n = len(runlog.read(f))
            if probs:
                bad += 1
                print(f"FAIL {f}  ({n} run(s), {len(probs)} problem(s))")
                for ln, msg in probs[:40]:
                    print(f"     line {ln}: {msg}")
            else:
                print(f"ok   {f}  ({n} run(s))")
        return 1 if bad else 0
    if sub == "show":
        target = Path(a[0] if a else ".")
        n = int(a[1]) if len(a) > 1 else 5
        files = [target] if target.is_file() else sorted(target.rglob(runlog.FILENAME))
        runs = sorted((r for f in files for r in runlog.read(f).values()), key=lambda r: r["start_ts"] or 0)[-n:]
        for r in runs:
            print(f"── {r['name']}  [{r['status']}]  {r['folder']}")
            print(runlog.timeline(r["file"], r["run"]))
            print()
        return 0
    if sub == "list":
        n = int(a[0]) if a else 40
        for r in runlog.all_runs(n):
            st = time.strftime("%m-%d %H:%M", time.localtime(r["start_ts"])) if r["start_ts"] else "?"
            mets = ", ".join(f"{k}={v}" for k, v in list(r["metrics"].items())[:3])
            print(f"{st}  {r['status']:<9} {runlog.fmt_seconds(r['seconds']):>7}  {r['project'][:18]:<18} {r['name'][:28]:<28} {mets}")
        return 0
    if sub == "index":
        paths = runlog.scan()
        print(f"{len(paths)} run log file(s) known")
        return 0
    if sub == "run":
        name, folder = None, None
        while a and a[0] != "--":
            if a[0] == "--name" and len(a) > 1:
                name, a = a[1], a[2:]
            elif a[0] == "--folder" and len(a) > 1:
                folder, a = a[1], a[2:]
            else:
                print(LOG_HELP)
                return 2
        cmd = a[1:] if a and a[0] == "--" else []
        if not cmd:
            print("usage: ms log run [--name N] [--folder DIR] -- CMD ...")
            return 2
        import re as _re
        name = _re.sub(r"[^A-Za-z0-9_.+-]", "_", name or (Path(cmd[0]).name + "_" + Path(folder or os.getcwd()).name))
        r = msrun.Run(name, folder=folder, cmd=" ".join(cmd)).start()
        out_path = Path(r.folder) / "msrun.out"
        errs = warns = 0
        rc = 1
        try:
            with open(out_path, "a") as out:
                p = subprocess.Popen(cmd, cwd=r.folder, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                     errors="replace", bufsize=1)
                for line in p.stdout:
                    sys.stdout.write(line)
                    out.write(line)
                    s_ = line.strip()
                    if _re.match(r"^(ERROR|FATAL|Error|Fatal)\b", s_) and errs < 100:
                        errs += 1
                        r.log("ERROR", s_[:1000], src=Path(cmd[0]).name)
                    elif _re.match(r"^(CRITICAL WARNING)\b", s_) and warns < 100:
                        warns += 1
                        r.log("WARN", s_[:1000], src=Path(cmd[0]).name)
                rc = p.wait()
        except KeyboardInterrupt:
            r.end("cancelled", rc=130, error="interrupted")
            return 130
        except OSError as e:
            r.log("ERROR", f"cannot start {cmd[0]}: {e}")
            r.end("failed", rc=127, error=str(e))
            return 127
        r.artifact("msrun.out", "log")
        if rc == 0 and not errs:
            r.end("ok", rc=0)
        else:
            r.end("failed", rc=rc or 1, error=f"exit code {rc}" + (f", {errs} ERROR line(s)" if errs else ""))
        return rc
    # ---- shell-script writer
    try:
        if sub == "start":
            if not a:
                print("usage: ms log start NAME [key=value ...]")
                return 2
            params = {}
            for kv in a[1:]:
                k, _, v = kv.partition("=")
                try:
                    v = _json.loads(v)
                except ValueError:
                    pass
                params[k] = v
            r = msrun.Run(a[0], params=params, cmd=os.environ.get("MSRUN_CMD", "shell")).start()
            st = {"name": a[0], "run": r.run, "t0": r._t0, "folder": r.folder, "stage": None}
            _save_shell(r, st)
            print(r.run)
            return 0
        r, st = _shell_run()
        if sub == "stage":
            r.stage(a[0])
        elif sub == "msg":
            r.log(a[0], " ".join(a[1:]))
        elif sub == "metric":
            v = a[1]
            try:
                v = _json.loads(v)
            except ValueError:
                pass
            r.metric(a[0], v, a[2] if len(a) > 2 else None)
        elif sub == "artifact":
            r.artifact(a[0], a[1] if len(a) > 1 else "other")
        elif sub == "progress":
            r.progress(float(a[0]), " ".join(a[1:]) or None)
        elif sub == "end":
            status = a[0] if a else "ok"
            rc = int(a[1]) if len(a) > 1 else None
            r.end(status, rc=rc, error=" ".join(a[2:]) or None)
            _log_state_path(st["folder"]).unlink(missing_ok=True)
            return 0
        else:
            print(LOG_HELP)
            return 2
        _save_shell(r, st)
        return 0
    except FileNotFoundError:
        print("no run started in this folder (ms log start NAME)")
        return 2
    except (ValueError, IndexError) as e:
        print(f"ms log: {e}")
        return 2


def doctor():
    ok = True
    units = ["my-system-watch.timer", "my-system-daily.timer", "my-system-report.timer", "my-system-queue.service"]
    if config.backup_repo():
        units += ["my-system-backup.timer", "my-system-verify.timer"]
    sysu = ["my-system-hwinfo.timer"] if Path("/etc/systemd/system/my-system-hwinfo.timer").exists() else []
    for unit in units + sysu:
        r = subprocess.run(["systemctl", *([] if unit in sysu else ["--user"]), "is-active", unit], capture_output=True, text=True)
        good = r.stdout.strip() == "active"
        ok &= good
        print(f"  {'ok ' if good else 'BAD'} {unit}: {r.stdout.strip()}")
    w = config.STATE / "watch.json"
    import time
    age = time.time() - w.stat().st_mtime if w.exists() else 1e9
    print(f"  {'ok ' if age < 300 else 'BAD'} watcher last ran {age / 60:.0f} min ago")
    pol = Path("/etc/claude-code/managed-settings.json")
    print(f"  {'ok ' if pol.exists() else 'BAD'} Claude Code policy {'installed' if pol.exists() else 'missing'}")
    st, txt = config.backup_state()
    good = st in ("ok", "running", "first")
    ok &= good
    print(f"  {'ok ' if good else 'BAD'} backup: {txt}")
    hst, _, age = hw.collector_state()
    if hst == "missing":
        print("  !!  hardware collector not installed (re-run ./install.sh)")
    else:
        good = hst == "ok"
        ok &= good
        print(f"  {'ok ' if good else 'BAD'} hardware data {age:.0f} h old")
    locked = (MS / "bin").stat().st_uid == 0
    print(f"  {'ok ' if locked else '!! '} code/config {'locked' if locked else 'unlocked'}")
    print(f"  plugins: {', '.join(p.NAME for p in plugins.load()) or 'none'}")
    return 0 if ok else 1


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    rest = argv[2:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd == "status":
        status()
    elif cmd == "gui":
        os.execv("/usr/bin/python3", ["/usr/bin/python3", str(MS / "gui" / "my_system_gui.py")])
    elif cmd == "check":
        return sh("run_daily.sh")
    elif cmd == "watch":
        watcher.tick()
    elif cmd == "detect":
        d = detect.write_state() if "--state" in rest else detect.detect_all()
        print(detect.summary(d))
    elif cmd == "write-initial-config":           # used by install.sh
        d, written = detect.write_initial(rest[0] if rest else None)
        print(detect.summary(d))
        print("config files written: " + (", ".join(written) or "none (all existed)"))
    elif cmd == "ai-context":
        aictx.write()
        print(f"written {aictx.path()}")
    elif cmd == "results":
        if not rest:
            print("usage: ms results DIR [--dry-run]")
            return 2
        results_backfill(rest[0], "--dry-run" not in rest)
    elif cmd == "git":
        for s in gitstat.run():
            p = gitstat.problems(s)
            print(f"{'!!' if p else 'ok'} {s['path']} [{s['branch']}] {', '.join(p)}")
    elif cmd == "sizes":
        for r in watcher.daily_sizes():
            print(f"{r[2]:>9} GB  {r[3]:4}  {r[1]}")
    elif cmd == "forecast":
        days, _, _ = watcher.forecast()
        print(watcher.forecast_text())
        return 1 if days is not None and days < 14 else 0
    elif cmd == "digest":
        print(digest.run())
    elif cmd == "notify-test":
        return sh("notify.sh", "Test from my-system", "If you see this on your phone, alerts work.", "default", "tada")
    elif cmd == "accept":
        return sh("accept_changes.sh")
    elif cmd in ("lock", "unlock"):
        return sh(f"{cmd}.sh")
    elif cmd == "backup-setup":
        return sh("backup_setup.sh")
    elif cmd == "backup":
        return sh("backup.sh")
    elif cmd == "backup-verify":
        return sh("backup_verify.sh")
    elif cmd == "move":
        return sh("move_to_hdd.sh", *rest)
    elif cmd == "report":
        path, recs = sysreport.run(notify="--notify" in rest)
        print(f"written {path}  (and {path.with_suffix('.md').name})")
        for p, t in recs:
            print(f"  [{p}] {t}")
        if "--open" in rest:
            subprocess.Popen(["xdg-open", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif cmd == "log":
        return log_cmd(rest)
    elif cmd in ("q", "queue"):
        from mysys import qcli
        if rest[:1] == ["serve"]:
            return qcli.webhook_cmd(rest[1:])
        return qcli.q_cmd(rest)
    elif cmd == "flow":
        from mysys import flow as _flow, qcli
        try:
            return qcli.flow_cmd(rest)
        except _flow.FlowError as e:
            print(f"Problems:\n{e}")
            return 1
    elif cmd == "sem":
        from mysys import qcli
        return qcli.sem_cmd(rest)
    elif cmd == "lineage":
        from mysys import qcli
        return qcli.lineage_cmd(rest)
    elif cmd == "secret":
        from mysys import qcli
        return qcli.secret_cmd(rest)
    elif cmd == "software":
        from mysys import software
        return software.cli(rest)
    elif cmd == "selftest":
        from mysys import selftest
        return selftest.run(rest)
    elif cmd == "mcp":
        from mysys import mcp
        mcp.serve()
    elif cmd == "capacity":
        if "--json" in rest:
            import json
            print(json.dumps(capacity.now(next((r for r in rest if not r.startswith("-")), None)), indent=1, default=str))
        else:
            print(capacity.now_text(next((r for r in rest if not r.startswith("-")), None)))
    elif cmd == "hw":
        hw.health_lines(update_prev=False)
    elif cmd == "doctor":
        return doctor()
    elif cmd == "replay":
        from mysys import history
        return history.cli(rest)
    elif cmd == "ping":
        if not rest:
            print("usage: ms ping NAME [start|fail|EXIT_CODE]   (URL from PING_<NAME> in my_system.conf)")
            return 2
        return 0 if config.ping(rest[0], rest[1] if len(rest) > 1 else "") else 1
    elif cmd == "brief":
        from mysys import brief
        return brief.cli(rest)
    elif cmd == "housekeeping":
        from mysys import housekeep
        housekeep.run(verbose=True)
    elif cmd == "version":
        print(__version__)
    else:
        print(f"unknown command: {cmd}\n{__doc__}")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
